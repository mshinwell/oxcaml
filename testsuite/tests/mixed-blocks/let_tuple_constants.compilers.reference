(let
  (uniform/0 =
     (function {nlocal = 0} param/0[value<int>] : int
       (catch
         (let (y/0 =[value<int>] 2 _x/0 =[value<int>] 1) (exit 1 _x/0 y/0))
        with (1 _x/1[value<int>] y/1[value<int>]) y/1))
   mixed_nonconstant/0 =
     (function {nlocal = 0} a/0? : unboxed_float
       (catch (let (y/2 =[float] #2.0) (exit 5 a/0 y/2))
        with (5 _x/2? y/3[float]) y/3))
   mixed_constant/0 =
     (function {nlocal = 0} param/1[value<int>] : int
       (catch
         (let (y/4 =[value<int>] 2 _x/3 =[float] #1.0) (exit 9 _x/3 y/4))
        with (9 _x/4[float] y/5[value<int>]) y/5)))
  (makeblock 0 uniform/0 mixed_nonconstant/0 mixed_constant/0))
