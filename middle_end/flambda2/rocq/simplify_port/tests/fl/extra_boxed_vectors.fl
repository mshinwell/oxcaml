(* extra_boxed_vectors.fl : boxed vectors whose bits Simplify knows, and
   the primitive Reinterpret_boxed_vector. The source language has no
   constant for a vector, so no OCaml source gives Simplify a vector that it
   knows; and the translation from Lambda makes Reinterpret_boxed_vector on
   arm64 only.
   Here: three functions that read a vector at a constant index of a static
   array and box it (Simplify lifts the boxed vector as a static constant),
   and one function that applies the primitive.
   The functions of the extracted Simplify that this test is meant to enter:
   ENTERS rebuilt_static_const.create_boxed_vec128
   ENTERS rebuilt_static_const.create_boxed_vec256
   ENTERS rebuilt_static_const.create_boxed_vec512
   ENTERS simplify_unary_primitive.simplify_reinterpret_boxed_vector *)
let $Vec128s = Vec128_array [|vec128[1L:2L]; vec128[3L:4L]|] in
let $Vec256s = Vec256_array [|vec256[1L:2L:3L:4L]|] in
let $Vec512s = Vec512_array [|vec512[1L:2L:3L:4L:5L:6L:7L:8L]|] in
let code size(8)
      lifted_0 (param : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : vec128 boxed =
  let x = %array_load.`vec128` ($Vec128s, 0) in
  let res = %box_num.`vec128`.my_alloc_region (x) in
  cont k (res)
in
let $Lifted = closure lifted_0 @lifted &toplevel in
let code size(8)
      lifted256_0 (param : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : vec256 boxed =
  let x = %array_load.`vec256` ($Vec256s, 0) in
  let res = %box_num.`vec256`.my_alloc_region (x) in
  cont k (res)
in
let $Lifted256 = closure lifted256_0 @lifted256 &toplevel in
let code size(8)
      lifted512_0 (param : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : vec512 boxed =
  let x = %array_load.`vec512` ($Vec512s, 0) in
  let res = %box_num.`vec512`.my_alloc_region (x) in
  cont k (res)
in
let $Lifted512 = closure lifted512_0 @lifted512 &toplevel in
let code size(8)
      reinterpret_0 (x : vec256 boxed)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  let y = %reinterpret_boxed_vector (x) in
  cont k (y)
in
let $Reinterpret = closure reinterpret_0 @reinterpret &toplevel in
let $camlExtra_boxed_vectors = Block 0 ($Lifted, $Lifted256, $Lifted512, $Reinterpret) in
cont done ($camlExtra_boxed_vectors)
