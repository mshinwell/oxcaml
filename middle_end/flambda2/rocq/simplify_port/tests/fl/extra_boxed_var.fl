(* extra_boxed_var.fl : a static boxed number whose content is a variable.
   THIS TERM STOPS SIMPLIFY WITH A FATAL ERROR, with the compiler's own
   Simplify too: simplify_static_const.ml looks the variable up with the
   kind of values, and here the variable is a naked float ("Kind .. doesn't
   match expected kind"). The extracted Simplify must stop in the same way,
   with the same message: the message prints the downwards accumulator, so
   it compares the printers of the two Simplifys too. The test is kept for
   that. It is meant to enter no function of the list. *)
let hidden_tagged = %opaque (41) in
let hidden_naked = %untag_imm (hidden_tagged) in
let f = %num_conv.[`imm`].[`float`] (hidden_naked) in
let $F = f : float boxed in
let $camlExtra_boxed_var = Block 0 ($F) in
cont done ($camlExtra_boxed_var)
