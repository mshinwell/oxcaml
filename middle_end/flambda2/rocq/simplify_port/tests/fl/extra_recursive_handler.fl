(* extra_recursive_handler.fl : a recursive continuation around the Switch
   at which Simplify decides to specialize a continuation. Every recursive
   continuation that the translation from Lambda makes (a loop) has a body
   that is one Apply_cont, so none is around a Switch.
   Here: the continuation kj has two uses, each with a constant; its handler
   switches on that constant, inside the scope of the recursive
   continuation loop. With the expert flags Simplify specializes kj, lifts
   loop out of it, and meets loop again when it replays the handler.
   The function of the extracted Simplify that this test is meant to enter,
   with the expert flags only:
   ENTERS-EXPERT one_recursive_handler.with_handler *)
let code size(40)
      f_0 (b : imm tagged, n : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let ub = %untag_imm (b) in
  (switch ub
     | 0 -> kj (0)
     | 1 -> kj (1))
    where kj (x : imm tagged) = (
      let ux = %untag_imm (x) in
      ((switch ux
          | 0 -> loop (n)
          | 1 -> k (n))
        where rec loop (i : imm tagged) = (
          let c = %phys_eq (i, 0) in
          (switch c
             | 0 -> k2
             | 1 -> k (i))
            where k2 =
              let j = %int_barith.sub (i, 1) in
              cont loop (j))))
in
let $F = closure f_0 @f &toplevel in
let $camlExtra_recursive_handler = Block 0 ($F) in
cont done ($camlExtra_recursive_handler)
