let code size(1) tupled constant my_closure &my_region my_depth -> k * e =
  cont k (7)
in
let $Constant = closure constant &toplevel in
let $Any = Block 0 (1, 2) in
let f = %opaque ($Constant) in
apply &toplevel f ($Any) -> k1 * error
  where k1 (r) =
    let $camlTupled_apply_zero = Block 0 (r) in
    cont done ($camlTupled_apply_zero)
