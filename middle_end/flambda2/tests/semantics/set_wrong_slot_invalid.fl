let code size(5) f (x) my_closure &my_region my_depth -> k * e =
  cont k (x)
and code size(5) g (x) my_closure &my_region my_depth -> k * e =
  let r = %int_barith.`add` (x, 1) in
  cont k (r)
and code size(5) h (x) my_closure &my_region my_depth -> k * e =
  let r = %int_barith.`add` (x, 2) in
  cont k (r)
in
let $Set_wrong_slot_invalid_f = closure f @f &toplevel
and $Set_wrong_slot_invalid_g = closure g @g &toplevel
and $Set_wrong_slot_invalid_h = closure h @h &toplevel
in
let a = %opaque (5) in
let c0 = %opaque ($Set_wrong_slot_invalid_f) in
let c1 = %project_function_slot.[f].[g] (c0) in
let c2 = %project_function_slot.[g].[h] (c0) in
apply &toplevel c2 (a) -> k1 * error
  where k1 (r) =
    let $camlSet_wrong_slot_invalid = Block 0 (r) in
    cont done ($camlSet_wrong_slot_invalid)
