;; The types of the compiler against their Rocq model
;; (middle_end/flambda2/types/rocq/), extracted with the machine of the
;; semantics (../extracted/).
;;
;; The library is the converter between [Type_grammar.t] and the model's
;; [flambda_type]: trusted, unverified OCaml, to be read against the two
;; grammars (type_converter.ml says how).

(library
 (name flambda2_rocq_types_converter)
 (modules model_numbers model_names model_type type_converter)
 (libraries
  ocamlfrontend
  flambda2_algorithms
  flambda2_bound_identifiers
  flambda2_identifiers
  flambda2_kinds
  flambda2_lattices
  flambda2_nominal
  flambda2_numbers
  flambda2_term_basics
  flambda2_types
  flambda2_rocq_semantics))

;; The generator of types and the differential tests, and the tool that runs
;; the comparisons of one type on the types that Simplify computes.

(executables
 (names types_difftest types_of_compilations)
 (modes native)
 (modules type_comparisons type_generator types_difftest
   types_of_compilations)
 (libraries
  ocamlfrontend
  ocamloptcomp
  minicheck
  flambda2
  flambda2_cmx
  flambda2_parser
  flambda2_simplify
  flambda2_terms
  flambda2_algorithms
  flambda2_bound_identifiers
  flambda2_identifiers
  flambda2_kinds
  flambda2_lattices
  flambda2_nominal
  flambda2_numbers
  flambda2_term_basics
  flambda2_types
  flambda2_ui
  flambda2_rocq_semantics
  flambda2_rocq_types_converter))

(rule
 (with-stdout-to
  types_difftest.output
  (run ./types_difftest.exe)))

(rule
 (alias runtest)
 (action
  (diff types_difftest.expected types_difftest.output)))

;; The types of the units of the semantics tests. The units are those that
;; types_of_compilations.units lists, and not all those that are there, so
;; that an example added to the semantics tests does not change the expected
;; file of this directory: the list is brought up to date with that file.

(rule
 (deps
  types_of_compilations.exe
  types_of_compilations.units
  (glob_files ../*.fl)
  (glob_files ../ocaml/*.fl))
 (action
  (with-stdout-to
   types_of_compilations.output
   (system "./types_of_compilations.exe $(cat types_of_compilations.units)"))))

(rule
 (alias runtest)
 (action
  (diff types_of_compilations.expected types_of_compilations.output)))

;; The types that the compiler kept of the units of the standard library in
;; their .cmx files. The files are those that the compiler of this context
;; finds (%{ocaml_where}), and so, in the context in which the tests are
;; run, those that the build of this tree made with its own compiler; in
;; another context they would be those of another compiler, and there is no
;; rule.

(rule
 (enabled_if
  (= %{context_name} main))
 (deps
  types_of_compilations.exe
  (glob_files %{ocaml_where}/*.cmx))
 (action
  (with-stdout-to
   types_of_cmx.output
   (run ./types_of_compilations.exe -cmx %{ocaml_where}))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} main))
 (action
  (diff types_of_cmx.expected types_of_cmx.output)))

;; A control of the tool on .cmx files, and of what it counts at the top of a
;; type. In a directory of their own: a unit compiled as usual; a unit
;; compiled with -opaque, whose .cmx file has no types and is to be counted
;; as not read; and a file that is no .cmx file, on which the run of the
;; tool is to stop and be counted so. The tool then ends with status 3.
;; What it writes on its other channel, where the loader says why it
;; stops, is kept apart and is not compared.

(subdir
 cmx_control
 (rule
  (enabled_if
   (= %{context_name} main))
  (action
   (progn
    (with-stdout-to
     with_types.ml
     (echo "let pair x = x, 1\n"))
    (with-stdout-to
     no_types.ml
     (echo "let pair x = x, 1\n"))
    (with-stdout-to
     rejected.cmx
     (echo "This is no .cmx file.\n")))))
 (rule
  (enabled_if
   (= %{context_name} main))
  (targets with_types.cmx with_types.cmi with_types.o)
  (action
   (run %{ocamlopt} -c %{dep:with_types.ml})))
 (rule
  (enabled_if
   (= %{context_name} main))
  (targets no_types.cmx no_types.cmi no_types.o)
  (action
   (run %{ocamlopt} -c -opaque %{dep:no_types.ml}))))

(rule
 (enabled_if
  (= %{context_name} main))
 (deps
  types_of_compilations.exe
  cmx_control/with_types.cmx
  cmx_control/no_types.cmx
  cmx_control/rejected.cmx)
 (action
  (with-stderr-to
   types_of_cmx_control.stderr
   (with-stdout-to
    types_of_cmx_control.output
    (progn
     (run ./types_of_compilations.exe -tops)
     (with-accepted-exit-codes
      3
      (run ./types_of_compilations.exe -cmx cmx_control)))))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} main))
 (action
  (diff types_of_cmx_control.expected types_of_cmx_control.output)))
