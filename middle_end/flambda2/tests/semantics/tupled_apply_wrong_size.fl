let code size(1) tupled first (x, y) my_closure &my_region my_depth -> k * e =
  cont k (x)
in
let $First = closure first &toplevel in
let $Triple = Block 0 (1, 2, 3) in
let f = %opaque ($First) in
apply &toplevel f ($Triple) -> k1 * error
  where k1 (r) =
    let $camlTupled_apply_wrong_size = Block 0 (r) in
    cont done ($camlTupled_apply_wrong_size)
