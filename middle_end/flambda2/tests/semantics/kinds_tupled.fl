let code size(1) tupled first (x) my_closure &my_region my_depth -> k * e =
  cont k (x)
in
let $First = closure first &toplevel in
let tuple = %block.[`0`].`toplevel` (5) in
apply &toplevel $First (tuple) -> k1 * error
  where k1 (r) =
    let $camlKinds_tupled = Block 0 (r) in
    cont done ($camlKinds_tupled)
