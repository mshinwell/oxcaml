let code size(5) add_one (x) my_closure &my_region my_depth -> k * e =
  let y = %int_barith.`add` (x, 1) in
  cont k (y)
in
let $Add_one = closure add_one @add_one &toplevel in
cont loop (0)
  where rec loop (i) =
    let c = %int_comp.`lt` (i, 5) in
    (switch c
       | 0 -> finish (i)
       | 1 -> again
       where again =
         apply &toplevel $Add_one (i) -> loop * error)
  where finish (r) =
    let $camlArity_text_recursive = Block 0 (r) in
    cont done ($camlArity_text_recursive)
