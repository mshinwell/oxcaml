let code size(5) add_one (x) my_closure &my_region my_depth -> k * e =
  let y = %int_barith.`add` (x, 1) in
  cont k (y)
in
let $Inline_in_code_add_one = closure add_one @add_one &toplevel in
let code size(20) add_two (x) my_closure &my_region my_depth -> k * e =
  apply direct(add_one &toplevel) inlined(always) $Inline_in_code_add_one (x)
    -> k1 * e
    where k1 (y) =
      apply direct(add_one &toplevel) inlined(always)
        $Inline_in_code_add_one (y)
        -> k * e
in
let $Inline_in_code_add_two = closure add_two @add_two &toplevel in
let $camlInline_in_code =
  Block 0 ($Inline_in_code_add_one, $Inline_in_code_add_two)
in
cont done ($camlInline_in_code)
