;; A test of ../from_ocaml.sh itself: of each X.ml here, X.says is what the
;; script says, "made" where it makes the text of the unit and otherwise the
;; reason that it prints, then "refused" (says.sh). The units go by twos: one
;; that the script refuses, for something that the text of a term loses and
;; the tool cannot give back, and the same unit without it. `dune promote`
;; updates X.says.

(rule
 (with-stdout-to
  probe.says.out
  (run sh %{dep:says.sh} %{dep:../from_ocaml.sh} %{ocamlopt} %{dep:probe.ml})))

(rule
 (alias runtest)
 (action
  (diff probe.says probe.says.out)))

(rule
 (with-stdout-to
  probe_not.says.out
  (run sh %{dep:says.sh} %{dep:../from_ocaml.sh} %{ocamlopt}
   %{dep:probe_not.ml})))

(rule
 (alias runtest)
 (action
  (diff probe_not.says probe_not.says.out)))
