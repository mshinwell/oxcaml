let code size(1) first (x, y) my_closure &my_region my_depth -> k * e =
  cont k (x)
in
let $First = closure first &toplevel in
let f = %opaque ($First) in
apply &toplevel f (1) -> k1 * error
  where k1 (p) =
    (apply &toplevel p (2) -> k2 * error
       where k2 (r) =
         let $camlApply_partial = Block 0 (r, p) in
         cont done ($camlApply_partial))
