let code size(1) first (x, y) my_closure &my_region my_depth -> k * e =
  cont k (x)
in
let $First = closure first &toplevel in
apply &toplevel $First (1) -> k1 * error
  where k1 (p) =
    (apply &toplevel p (2) -> k2 * error
       where k2 (r) =
         let $camlApply_partial_known = Block 0 (r) in
         cont done ($camlApply_partial_known))
