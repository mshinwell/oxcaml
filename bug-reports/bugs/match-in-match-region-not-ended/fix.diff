+(* An [End_region] is not recorded as a use of its region, and is deleted when
+   the name it is given is not required (see [Simplify_let_expr]). That is right
+   as long as this name is the one bound by the [Begin_region]: the region is
+   then begun and ended, or neither. It is not when the name is a parameter of a
+   continuation which stands for the regions passed for it (the lifting of
+   continuations makes such parameters): these regions can be required, by the
+   allocations made in them, while the parameter is not, and would then never be
+   ended.
+
+   So, for every variable given to an [End_region] which is a parameter, and for
+   every variable [arg] passed for it, we add the dependency "if [arg] is used
+   then the parameter is used"; and likewise for [arg] if it is itself a
+   parameter, since it stands for the same regions. With the dependency in the
+   other direction, which every parameter has, the parameter and the regions
+   passed for it are then all required or all not required: the [Begin_region]s
+   and the [End_region] are all kept, or all deleted. *)
+let add_region_dependencies (map : T.Continuation_info.t Continuation.Map.t) t =
+  let ended_regions =
+    Continuation.Map.fold
+      (fun _ (elt : T.Continuation_info.t) acc ->
+        Variable.Set.union elt.ended_regions acc)
+      map Variable.Set.empty
+  in
+  if Variable.Set.is_empty ended_regions
+  then t
+  else
+    (* The continuations that have parameters of kind [Region], with the indexes
+       of these parameters. *)
+    let region_params =
+      Continuation.Map.filter_map
+        (fun _ (elt : T.Continuation_info.t) ->
+          let _, region_params =
+            List.fold_left
+              (fun (i, region_params) param ->
+                let is_region =
+                  Flambda_kind.equal
+                    (Flambda_kind.With_subkind.kind
+                       (Bound_parameter.kind param))
+                    Flambda_kind.region
+                in
+                ( i + 1,
+                  if is_region
+                  then (i, Bound_parameter.var param) :: region_params
+                  else region_params ))
+              (0, [])
+              (Bound_parameters.to_list elt.params)
+          in
+          match region_params with [] -> None | _ :: _ -> Some region_params)
+        map
+    in
+    (* The variables passed for each of these parameters. *)
+    let args_of_region_params =
+      Continuation.Map.fold
+        (fun _ (elt : T.Continuation_info.t) acc ->
+          Continuation.Map.fold
+            (fun k rewrite_ids acc ->
+              match Continuation.Map.find_opt k region_params with
+              | None -> acc
+              | Some region_params ->
+                Apply_cont_rewrite_id.Map.fold
+                  (fun _rewrite_id args acc ->
+                    List.fold_left
+                      (fun acc (i, param) ->
+                        match Numeric_types.Int.Map.find_opt i args with
+                        | Some (T.Cont_arg.Simple simple) -> (
+                          match Simple.must_be_var simple with
+                          | None -> acc
+                          | Some (arg, _coercion) ->
+                            Variable.Map.update param
+                              (function
+                                | None -> Some (Variable.Set.singleton arg)
+                                | Some args -> Some (Variable.Set.add arg args))
+                              acc)
+                        | Some
+                            ( T.Cont_arg.Function_result
+                            | T.Cont_arg.New_let_binding _ )
+                        | None ->
+                          acc)
+                      acc region_params)
+                  rewrite_ids acc)
+            elt.apply_cont_args acc)
+        map Variable.Map.empty
+    in
+    let rec loop t seen = function
+      | [] -> t
+      | param :: todo -> (
+        match Variable.Map.find_opt param args_of_region_params with
+        | None -> loop t seen todo
+        | Some args ->
+          let t =
+            Variable.Set.fold
+              (fun arg t ->
+                add_dependency ~src:(Name.var arg) ~dst:(Name.var param) t)
+              args t
+          in
+          let new_args = Variable.Set.diff args seen in
+          loop t
+            (Variable.Set.union new_args seen)
+            (Variable.Set.elements new_args @ todo))
+    in
+    loop t ended_regions (Variable.Set.elements ended_regions)
+
