 val joined_env : t -> env_id -> Typing_env.t
 
+type now_expanding_result = private
+  | Continue of t
+  | Stop
+
+(** To be called by the join of types before it expands types of which some are
+    aliases and some are not, and joins their heads. The head of an alias is a
+    type of an environment and not a part of the type that was given, so the
+    size of the types does not bound the recursion of the join through such
+    expansions; their depth is counted here and bounded by the join depth.
+    [Stop]: the bound is reached, and the join should answer the unknown type.
+    [Continue t]: the heads are to be joined in [t], and [done_expanding] called
+    on the environment that their join answers. *)
+val now_expanding : t -> now_expanding_result
+
+val done_expanding : t -> t
+
 val machine_width : t -> Target_system.Machine_width.t
 
 val import_type : t -> Type_grammar.t -> t
