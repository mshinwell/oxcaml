-let flush_delayed_lets ~mode env res =
+(* The environment in which the handler of a continuation that is not inlined
+   is translated: nothing that is held can be substituted into it. Such a
+   handler runs after the whole of the body, so a binding substituted into it
+   would be computed after everything that the body does: a store, a call,
+   the end of the region of a block that the binding reads. Only the bindings
+   that are duplicated at each use and are trivial (a variable, a constant, a
+   symbol) stay. The bindings that the handler uses are then flushed before
+   the continuation ([flush_delayed_lets ~used_by_handler]). *)
+let for_handler_of_continuation_not_inlined env =
+  let keep (type a) (b : a binding) =
+    match b.inline with
+    | Must_inline_and_duplicate -> (
+      match b.bound_expr with
+      | Split { cmm_expr; free_vars = _ } -> is_cmm_simple cmm_expr
+      | Splittable_prim _ -> false)
+    | Do_not_inline | May_inline_once | Must_inline_once -> false
+  in
+  { env with
+    bindings = Variable.Map.filter (fun _ (Binding b) -> keep b) env.bindings;
+    effect_stages = [];
+    validity_stages = [];
+    symbol_inits = Backend_var.Map.empty
+  }
+
+let flush_delayed_lets ?(used_by_handler = Backend_var.Set.empty) ~mode env res =
   (* CR-someday mshinwell: work out a criterion for allowing substitutions into
      loops. CR gbury: this is now done by creating a binding with the inline
      status `Must_inline_and_duplicate`, so the caller of `to_cmm_env` has to
@@ -1190,6 +1220,14 @@ let flush_delayed_lets ~mode env res =
   let bindings_to_keep =
     Variable.Map.filter_map_sharing
       (fun _ (Binding b as binding) ->
+        let mode =
+          if
+            Backend_var.Set.mem
+              (Backend_var.With_provenance.var b.cmm_var)
+              used_by_handler
+          then Flush_everything
+          else mode
+        in
         match b.inline with
         | Do_not_inline ->
           flush binding;
