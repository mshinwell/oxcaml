+(* [regain_tail_position exp], for an expression [exp] that is in tail
+   position of its function.
+
+   Some expressions leave no code around their argument: the field of an
+   unboxed record, an unboxed constructor, the construction of an unboxed
+   record, the primitive "%identity" ([Translcore] and [Translprim] give the
+   translation of the argument itself). If the argument is an application,
+   that application is the last thing that the function does, but it was
+   typed as an argument, at position [Default]: the region of the function,
+   if it has one, is ended only after the call returns, and a loop written so
+   does not run in constant stack (in upstream OCaml the same source does).
+
+   Such an application could be a tail call under the conditions that [Tail]
+   imposes on an application written in tail position: the function, the
+   arguments and the result are not local to the region (see the [Tail]
+   cases of [mode_argument] and of [Pexp_apply], and
+   [check_tail_call_local_returning]). Imposing them here would refuse
+   programs that are accepted (one that passes a value on the stack to such
+   a call), and whether they hold is not known yet: the modes are still
+   being inferred. So the application is only given the position
+   [Tail_if_not_local], with the join of these modes, and [Translcore]
+   decides when inference is over. No constraint is added: no program is
+   refused, no mode and no allocation changes. *)
+let rec regain_tail_position (exp : expression) : expression =
+  let no_region =
+    List.for_all
+      (function
+        | (Texp_ghost_region | Texp_borrowed), _, _ -> false
+        | _ -> true)
+      exp.exp_extra
+  in
+  if not no_region then exp else
+  match exp.exp_desc with
+  | Texp_apply (funct, [lbl, Arg (arg, sort)], ((Tail | Default) as pos),
+                ap_mode, ap_yielding, zero_alloc)
+    when is_prim ~name:"%identity" funct ->
+      let arg' = regain_tail_position arg in
+      if arg' == arg then exp
+      else
+        { exp with
+          exp_desc =
+            Texp_apply (funct, [lbl, Arg (arg', sort)], pos, ap_mode,
+                        ap_yielding, zero_alloc) }
+  | Texp_apply (funct, args, Default, ap_mode, ap_yielding, zero_alloc) ->
+      begin match !untaken_tail_call with
+      | Some ut when ut.ut_desc == exp.exp_desc ->
+          let mode =
+            Regionality.join
+              (locality_as_regionality ut.ut_ap_mode
+               :: List.map (With_regionality.proj_comonadic Areality)
+                    ut.ut_passed)
+          in
+          let mode =
+            (* As for the other modes kept in the typed tree. *)
+            if Language_extension.(is_at_least Mode_polymorphism Alpha)
+            then fst (Regionality.newvar_above 0 mode)
+            else mode
+          in
+          { exp with
+            exp_desc =
+              Texp_apply (funct, args, Tail_if_not_local mode, ap_mode,
+                          ap_yielding, zero_alloc) }
+      | Some _ | None -> exp
+      end
+  | Texp_field
+      ({ record;
+         record_repres =
+           (Record_unboxed | Record_inlined (_, _, Variant_unboxed));
+         _ } as field) ->
+      let record' = regain_tail_position record in
+      if record' == record then exp
+      else { exp with exp_desc = Texp_field { field with record = record' } }
+  | Texp_construct (lid, cstr, repr, [sort, arg], alloc_mode)
+    when (match cstr.cstr_tag, cstr.cstr_repr with
+          | Ordinary _, (Variant_unboxed | Variant_with_null) -> true
+          | _ -> false) ->
+      let arg' = regain_tail_position arg in
+      if arg' == arg then exp
+      else
+        { exp with
+          exp_desc = Texp_construct (lid, cstr, repr, [sort, arg'], alloc_mode)
+        }
+  | Texp_record
+      ({ fields = [| label, sort, Overridden (lid, arg) |];
+         representation =
+           (Record_unboxed | Record_inlined (Ordinary _, _, Variant_unboxed));
+         extended_expression = None;
+         _ } as record) ->
+      let arg' = regain_tail_position arg in
+      if arg' == arg then exp
+      else
+        { exp with
+          exp_desc =
+            Texp_record
+              { record with
+                fields = [| label, sort, Overridden (lid, arg') |] } }
+  | _ -> exp
+
