diff --git a/typing/typecore.ml b/typing/typecore.ml
index 9c94cfb..3af93f5 100644
--- a/typing/typecore.ml
+++ b/typing/typecore.ml
@@ -9387,9 +9387,21 @@ and type_expect_
           bop_exp_sort = exp_sort;
           bop_loc = slet.pbop_loc; }
       in
+      (* The application of the [let] operator is the last action of the
+         function when this expression is. All that the application is given
+         (the operator, the bound expressions, the function made of the body)
+         is typed at the legacy mode above, and so is its result: nothing of
+         the current region can be reached from the call, and the region can
+         be ended before it, as for an application in the same place (see
+         [position_and_mode]; attributes are not looked at here). *)
+      let position : apply_position =
+        match expected_mode.position with
+        | RTail (_, FTail) -> Tail
+        | RNontail | RTail (_, FNontail) -> Default
+      in
       let desc =
         Texp_letop{let_; ands; param; param_debug_uid; param_sort; body;
-                   body_sort; partial}
+                   body_sort; partial; position}
       in
       rue { exp_desc = desc;
             exp_loc = sexp.pexp_loc;
